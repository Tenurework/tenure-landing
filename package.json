{
  "name": "tenure-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:perf": "node scripts/check-perf.mjs",
    "claims:build": "node scripts/build-claims-doc.mjs",
    "claims:evidence": "node scripts/build-evidence-manifest.mjs",
    "test": "playwright test",
    "test:e2e": "playwright test nav.spec.ts interaction.spec.ts",
    "test:a11y": "playwright test a11y.spec.ts",
    "test:seo": "playwright test seo.spec.ts",
    "test:claims": "playwright test claims.spec.ts",
    "test:visual": "playwright test visual.spec.ts",
    "test:visual:update": "playwright test visual.spec.ts --update-snapshots",
    "test:ui": "playwright test --ui",
    "verify": "npm run lint && npm run claims:verify && npm run typecheck && npm run check:contrast && npm run build && npm run check:links && npm run test",
    "claims:verify": "node scripts/verify-product-claims.mjs"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.25",
    "motion": "^12.42.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "lighthouse": "^13.4.1",
    "playwright": "^1.61.1",
    "simple-icons": "^16.28.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
